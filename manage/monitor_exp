#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

if ! command -v uv >/dev/null 2>&1; then
  echo "uv is not installed. Install uv first: https://docs.astral.sh/uv/"
  exit 1
fi

if [ "$#" -lt 1 ]; then
  echo "Usage: manage/monitor_exp <relative-exp-path>"
  echo "Example: manage/monitor_exp outputs/grpo_student_post_sft/20260328_232614"
  exit 1
fi

PYTHONPATH="$ROOT_DIR/src" uv run python -m runners.monitor_exp "$1"
